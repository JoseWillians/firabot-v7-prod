# Nome exibido nas mensagens do bot.
BOT_NAME=Firabot v7

# Campus usado na saudação institucional.
BOT_CAMPUS=IFMA Santa Inês

# Pasta onde os PDFs ficam disponíveis para envio.
DOCUMENTS_DIR=./documentos

# Se true, ignora mensagens anteriores ao início da instância do bot.
IGNORE_OLD_MESSAGES=true

# Se true, não responde mensagens em grupos.
IGNORE_GROUPS=true

# Logs detalhados para depuração.
DEBUG_MODE=false
LOG_LEVEL=info

# Ajustes operacionais.
MESSAGE_START_GRACE_SECONDS=0
SPAM_WINDOW_MS=2500
MESSAGE_DEDUP_TTL_MS=600000
RECONNECT_DELAY_MS=5000
USER_STATE_TTL_MINUTES=60
DOCUMENT_MAX_SIZE_MB=25

# 0 desativa exclusão automática até existir política institucional aprovada.
SUPPORT_TICKET_RETENTION_DAYS=0

# Números autorizados para comandos administrativos, separados por vírgula.
# Use somente números completos com DDI/DDD, entre 10 e 15 dígitos.
# Valores inválidos são ignorados e exigem reinício após correção.
# Exemplo: 5598999999999
ADMIN_NUMBERS=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=firabot_app
# Deixe vazio para usar MYSQL_DATABASE; se preencher, deve ser igual a ele.
DB_NAME=

# Credencial do usuário de runtime com permissões limitadas (SELECT/INSERT/UPDATE/DELETE).
# Gere senha hexadecimal aleatória com pelo menos 32 caracteres.
FIRABOT_APP_DB_PASSWORD=

# Variáveis opcionais usadas apenas pelo Docker Compose/MySQL local.
# DOTENV_CONFIG_PATH pode apontar para um arquivo exclusivo de testes.
# Omita em operacao normal para manter a leitura padrao de .env.
# DOTENV_CONFIG_PATH=./.env.test
# Obrigatórias para Compose local; use valores hexadecimais aleatórios e distintos.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
FIRABOT_MIGRATION_DB_PASSWORD=
