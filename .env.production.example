# Copie para .env.production apenas no servidor e substitua todos os placeholders.
# Nunca versione o arquivo real nem reutilize as credenciais de desenvolvimento.
BOT_NAME=FiraBot
BOT_CAMPUS=IFMA Santa Inês
DOCUMENTS_DIR=/app/documentos
IGNORE_OLD_MESSAGES=true
DEBUG_MODE=false
LOG_LEVEL=info
USER_STATE_TTL_MINUTES=60
MESSAGE_DEDUP_TTL_MS=600000
SUPPORT_TICKET_RETENTION_DAYS=0
ADMIN_NUMBERS=

# Banco usado pelo bot dentro do Docker Compose de produção.
DB_HOST=mysql
DB_PORT=3306
DB_USER=firabot_app
DB_PASSWORD=substitua-por-uma-senha-forte
DB_NAME=firabot

# Variáveis consumidas pelo serviço MySQL do docker-compose.prod.yml.
MYSQL_ROOT_PASSWORD=substitua-por-outra-senha-forte
MYSQL_DATABASE=firabot
MYSQL_USER=firabot_app
MYSQL_PASSWORD=substitua-por-uma-senha-forte
