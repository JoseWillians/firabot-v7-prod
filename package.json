{
  "name": "firabot-v7",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && npm run test:no-build",
    "test:no-build": "node tests/run-tests.mjs",
    "test:integration": "node tests/integration/message-handler.integration.mjs",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "ci:local": "npm run lint && npm run typecheck && npm run build && npm run test:no-build",
    "db:backup": "node scripts/db-backup.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:cleanup:support": "node scripts/cleanup-support-tickets.mjs --confirm",
    "db:restore:test": "node scripts/db-restore-test.mjs --confirm",
    "dev": "tsx src/index.ts",
    "clean": "rimraf dist",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "baileys": "^7.0.0-rc.14",
    "dotenv": "^17.4.0",
    "mysql2": "^3.24.4",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "^0.12.2",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.2",
    "typescript-eslint": "8.70.0"
  }
}
